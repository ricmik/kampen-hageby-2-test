---
layout: null
permalink: /search.json
---
[
{% assign rendered = false %}
{% for item in site.posts %}
  {% if item.title %}
    {% if rendered %},{% endif %}
    {
      "title": {{ item.title | jsonify }},
      "url": {{ item.url | relative_url | jsonify }},
      "content": {{ item.content | strip_html | normalize_whitespace | jsonify }},
      "summary": {{ item.summary | default: item.excerpt | strip_html | normalize_whitespace | jsonify }},
      "category": {{ item.category | default: "Nyhet" | jsonify }},
      "date": {{ item.date | date: "%Y-%m-%d" | jsonify }},
      "type": "Nyhet"
    }
    {% assign rendered = true %}
  {% endif %}
{% endfor %}
{% for item in site.dokumenter %}
  {% if item.title and item.file %}
    {% if rendered %},{% endif %}
    {
      "title": {{ item.title | jsonify }},
      "url": {{ item.file | jsonify }},
      "content": {{ item.summary | default: item.category | normalize_whitespace | jsonify }},
      "summary": {{ item.summary | default: item.category | normalize_whitespace | jsonify }},
      "category": {{ item.category | default: "Dokument" | jsonify }},
      "date": {{ item.date | date: "%Y-%m-%d" | jsonify }},
      "type": "Dokument"
    }
    {% assign rendered = true %}
  {% endif %}
{% endfor %}
{% for item in site.faq %}
  {% if item.title %}
    {% if rendered %},{% endif %}
    {% capture faq_url %}/ofte-stilte-sporsmal.html#{{ item.title | slugify }}{% endcapture %}
    {
      "title": {{ item.title | jsonify }},
      "url": {{ faq_url | relative_url | jsonify }},
      "content": {{ item.content | strip_html | normalize_whitespace | jsonify }},
      "summary": {{ item.content | strip_html | normalize_whitespace | jsonify }},
      "category": "Ofte stilte spørsmål",
      "date": "",
      "type": "Spørsmål og svar"
    }
    {% assign rendered = true %}
  {% endif %}
{% endfor %}
{% for item in site.pages %}
  {% if item.title and item.url != '/' and item.url != '/search.html' and item.url != '/search.json' %}
    {% if rendered %},{% endif %}
    {
      "title": {{ item.title | jsonify }},
      "url": {{ item.url | relative_url | jsonify }},
      "content": {{ item.content | strip_html | normalize_whitespace | jsonify }},
      "summary": {{ item.summary | default: item.lead | default: item.excerpt | strip_html | normalize_whitespace | jsonify }},
      "category": {{ item.eyebrow | default: "Side" | jsonify }},
      "date": {{ item.date | default: site.time | date: "%Y-%m-%d" | jsonify }},
      "type": "Side"
    }
    {% assign rendered = true %}
  {% endif %}
{% endfor %}
]
